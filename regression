      "source": [
        "import numpy as np\n",
        "\n",
        "# Data\n",
        "X = np.array([1, 2, 3, 4, 5], dtype=float)\n",
        "Y = np.array([2, 4, 5, 4, 5], dtype=float)\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Initial values\n",
        "b0 = 0\n",
        "b1 = 0\n",
        "\n",
        "learning_rate = 0.01\n",
        "epochs = 1000\n",
        "\n",
        "n = len(X)"
      ],
      "metadata": {
        "id": "ArnYbSTnEBYf"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Gradient Descent\n",
        "for i in range(epochs):\n",
        "\n",
        "    # Predictions\n",
        "    Y_pred = b0 + b1 * X\n"
      ],
      "metadata": {
        "id": "yi8Vtc5_EBnf"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Calculate gradients\n",
        "    db0 = (-2/n) * np.sum(Y - Y_pred)\n",
        "    db1 = (-2/n) * np.sum(X * (Y - Y_pred))\n"
      ],
      "metadata": {
        "id": "bByv_Pa8EIxO"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "  # Update b0 and b1\n",
        "    b0 = b0 - learning_rate * db0\n",
        "    b1 = b1 - learning_rate * db1"
      ],
      "metadata": {
        "id": "nc_xRXUbEI-G"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"b0 =\", b0)\n",
        "print(\"b1 =\", b1)\n",
        "\n",
        "print(\"Regression Equation:\")\n",
        "print(\"Y =\", b0, \"+\", b1, \"X\")"
      ],
